# Copy this file to ".env" (same folder) and fill in your key.
# Get a free SmartSpectra API key from the Presage developer portal:
#   https://physiology.presagetech.com
# The .env file is gitignored — never commit your key.

SMARTSPECTRA_API_KEY=

# Optional: SmartSpectra SDK telemetry. Pip ships with telemetry OFF and
# this stays off unless you set it to "true" here. With telemetry on, the
# SDK sends Presage aggregate session summaries and device-readiness
# reports (never video frames or measured values). See README → Privacy.
SMARTSPECTRA_TELEMETRY=false

# Optional: port for Pip's local server (default 3000).
# PORT=3000
